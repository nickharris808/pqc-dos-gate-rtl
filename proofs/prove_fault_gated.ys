# prove_fault_gated.ys — prove (S1) resident <= CAP holds under a SINGLE token-bypass
# fault, by temporal k-induction (unbounded over all reachable states).
# Success => "Induction step proven: SUCCESS!".
read_verilog -formal -DFORMAL ../rtl/bounded_reassembly_fault.v
prep -top bounded_reassembly_fault
async2sync
chformal -lower
sat -tempinduct -prove-asserts -set-init-zero -verify
